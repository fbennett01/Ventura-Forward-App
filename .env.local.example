# --- Reports (anonymous device-id) Supabase project ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Ventura Rewards (separate Supabase project = SHARED live agency DB) ---
# Leave these UNSET to run Rewards in demo mode (localStorage points, no DB
# writes). Demo mode is the default until the rewards backend is configured.
NEXT_PUBLIC_REWARDS_SUPABASE_URL=
NEXT_PUBLIC_REWARDS_SUPABASE_ANON_KEY=
REWARDS_SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret for signing short-lived member QR tokens (server-only).
REWARDS_QR_SECRET=
# Shared code that gates the beta in-app vendor scanner at /vendor/scan
# (server-checked on /api/rewards/award). Not used by the production dashboard.
REWARDS_VENDOR_ACCESS_CODE=
# Force demo mode even when the rewards project IS configured. Leave blank for
# live mode; set to `true` to keep using localStorage points.
NEXT_PUBLIC_REWARDS_DEMO=
